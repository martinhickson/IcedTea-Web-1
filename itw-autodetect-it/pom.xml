<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.sourceforge.icedtea-web</groupId>
  <artifactId>itw-autodetect-it</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>IcedTea-Web Windows JDK autodetect integration tests</name>
  <description>
    Standalone Windows GUI integration test: Undertow-hosted JNLP requiring JDK 17,
    javaws Autodetect dialog, app launch, and control-panel verification.
    Not part of the main reactor. Expected to fail until Windows JDK autodetect works.
  </description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>11</maven.compiler.release>
    <icedtea-web.version>2.0.1-SNAPSHOT</icedtea-web.version>
    <assertj-swing.version>3.17.1</assertj-swing.version>
    <byte-buddy.version>1.18.8</byte-buddy.version>
    <junit.version>5.10.2</junit.version>
    <version.undertow>2.3.10.Final</version.undertow>
    <itw.test.home>${project.build.directory}/itw-test-home</itw.test.home>
    <!-- Space-free junctions (see C:\itw-jdks); discoverable copy under LOCALAPPDATA via ensure-discoverable-jdk17.ps1 -->
    <itw.jdk11.home>C:\itw-jdks\jdk-11</itw.jdk11.home>
    <itw.jdk17.home>C:\itw-jdks\jdk-17</itw.jdk17.home>
    <itw.javaws.bin>${project.basedir}/../icedtea-web-distribution/target/dist/icedtea-web-${icedtea-web.version}/bin/javaws.exe</itw.javaws.bin>
    <itw.launch.timeout.seconds>180</itw.launch.timeout.seconds>
    <!-- TDD: keep true until Windows JDK 17 autodetect + Apply path is green -->
    <itw.autodetect.it.failure.ignore>true</itw.autodetect.it.failure.ignore>
  </properties>

  <dependencies>
    <dependency>
      <groupId>net.sourceforge.icedtea-web</groupId>
      <artifactId>icedtea-web</artifactId>
      <version>${icedtea-web.version}</version>
      <classifier>uber</classifier>
    </dependency>
    <dependency>
      <groupId>io.undertow</groupId>
      <artifactId>undertow-core</artifactId>
      <version>${version.undertow}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-swing-junit</artifactId>
      <version>${assertj-swing.version}</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>junit</groupId>
          <artifactId>junit</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-swing</artifactId>
      <version>${assertj-swing.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>${byte-buddy.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>unpack-byte-buddy-for-dialog-agent</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>net.bytebuddy</groupId>
                  <artifactId>byte-buddy</artifactId>
                  <version>${byte-buddy.version}</version>
                  <outputDirectory>${project.build.directory}/dialog-agent-classes</outputDirectory>
                  <excludes>META-INF/MANIFEST.MF,META-INF/LICENSE*,META-INF/NOTICE*</excludes>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>prepare-itw-test-home</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <delete dir="${itw.test.home}" quiet="true"/>
                <mkdir dir="${itw.test.home}/.config/icedtea-web"/>
                <mkdir dir="${itw.test.home}/.cache/icedtea-web"/>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>ensure-discoverable-jdk17</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <exec executable="powershell.exe" failonerror="false">
                  <arg value="-NoProfile"/>
                  <arg value="-ExecutionPolicy"/>
                  <arg value="Bypass"/>
                  <arg value="-File"/>
                  <arg value="${project.basedir}/scripts/ensure-discoverable-jdk17.ps1"/>
                  <env key="ITW_JDK17_HOME" value="${itw.jdk17.home}"/>
                </exec>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>compile-java17-jnlp-app</id>
            <phase>generate-test-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <exec executable="powershell.exe" failonerror="true">
                  <arg value="-NoProfile"/>
                  <arg value="-ExecutionPolicy"/>
                  <arg value="Bypass"/>
                  <arg value="-File"/>
                  <arg value="${project.basedir}/scripts/compile-java17-app.ps1"/>
                  <env key="ITW_JDK17_HOME" value="${itw.jdk17.home}"/>
                  <env key="ITW_TEST_HOME" value="${itw.test.home}"/>
                </exec>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>copy-dialog-agent-classes</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <copy todir="${project.build.directory}/dialog-agent-classes">
                  <fileset dir="${project.build.testOutputDirectory}">
                    <include name="net/sourceforge/icedteaweb/autodetect/it/agent/**"/>
                  </fileset>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <executions>
          <execution>
            <id>dialog-agent-jar</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classesDirectory>${project.build.directory}/dialog-agent-classes</classesDirectory>
              <classifier>dialog-agent</classifier>
              <archive>
                <manifestEntries>
                  <Premain-Class>net.sourceforge.icedteaweb.autodetect.it.agent.AutodetectDialogAgent</Premain-Class>
                  <Agent-Class>net.sourceforge.icedteaweb.autodetect.it.agent.AutodetectDialogAgent</Agent-Class>
                  <Can-Redefine-Classes>true</Can-Redefine-Classes>
                  <Can-Retransform-Classes>true</Can-Retransform-Classes>
                </manifestEntries>
              </archive>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <skipTests>true</skipTests>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <excludes>
            <exclude>**/SampleAppHostIT.java</exclude>
          </excludes>
          <testFailureIgnore>${itw.autodetect.it.failure.ignore}</testFailureIgnore>
          <systemPropertyVariables>
            <user.home>${itw.test.home}</user.home>
            <java.awt.headless>false</java.awt.headless>
            <swing.defaultlaf>javax.swing.plaf.metal.MetalLookAndFeel</swing.defaultlaf>
            <itw.javaws.bin>${itw.javaws.bin}</itw.javaws.bin>
            <itw.test.jnlp.root>${project.build.directory}/test-jnlp-samples</itw.test.jnlp.root>
            <itw.jdk11.home>${itw.jdk11.home}</itw.jdk11.home>
            <itw.jdk17.home>${itw.jdk17.home}</itw.jdk17.home>
            <itw.launch.timeout.seconds>${itw.launch.timeout.seconds}</itw.launch.timeout.seconds>
            <itw.dialog.agent.jar>${project.build.directory}/${project.artifactId}-${project.version}-dialog-agent.jar</itw.dialog.agent.jar>
            <icedtea-web.bin.location>${itw.javaws.bin}</icedtea-web.bin.location>
          </systemPropertyVariables>
          <environmentVariables>
            <XDG_CONFIG_HOME>${itw.test.home}/.config</XDG_CONFIG_HOME>
            <XDG_CACHE_HOME>${itw.test.home}/.cache</XDG_CACHE_HOME>
            <HOME>${itw.test.home}</HOME>
          </environmentVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Activate with: mvn -Psample-app verify -->
  <profiles>
    <profile>
      <id>sample-app</id>
      <properties>
        <!-- Keep the JNLP app alive a long time after a manual launch. -->
        <itw.test.hold.seconds>3600</itw.test.hold.seconds>
        <itw.sample.app.wait.seconds>86400</itw.sample.app.wait.seconds>
        <itw.autodetect.it.failure.ignore>false</itw.autodetect.it.failure.ignore>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.2.5</version>
            <configuration combine.self="override">
              <includes>
                <include>**/SampleAppHostIT.java</include>
              </includes>
              <testFailureIgnore>false</testFailureIgnore>
              <systemPropertyVariables>
                <user.home>${itw.test.home}</user.home>
                <java.awt.headless>true</java.awt.headless>
                <itw.test.jnlp.root>${project.build.directory}/test-jnlp-samples</itw.test.jnlp.root>
                <itw.jdk17.home>${itw.jdk17.home}</itw.jdk17.home>
                <itw.test.hold.seconds>${itw.test.hold.seconds}</itw.test.hold.seconds>
                <itw.sample.app.wait.seconds>${itw.sample.app.wait.seconds}</itw.sample.app.wait.seconds>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
