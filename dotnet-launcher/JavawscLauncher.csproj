<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Console subsystem (CUI): cmd/bash wait naturally. Canonical CLI entry (java.exe / javaw / javawsc). -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>javawsc</AssemblyName>
    <RootNamespace>IcedTeaWeb.Launcher</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DefineConstants>$(DefineConstants);ITW_LAUNCHER_CONSOLE</DefineConstants>
  </PropertyGroup>
</Project>
