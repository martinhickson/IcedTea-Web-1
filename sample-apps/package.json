{
  "name": "sample-apps",
  "version": "1.0.0",
  "private": true,
  "description": "IcedTea-Web JNLP sample catalog with shared Angular dev server",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run build:jnlp",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "build": "ng build",
    "build:jnlp": "node scripts/prepare-jnlp.mjs",
    "build:jnlp:swing-gui": "node scripts/prepare-jnlp.mjs swing-gui",
    "build:jnlp:console": "node scripts/prepare-jnlp.mjs console",
    "launch:console": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/launch-console.ps1",
    "test:console": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-console.ps1"
  },
  "volta": {
    "node": "22.14.0",
    "npm": "10.9.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": "^10.0.0"
  },
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "typescript": "~5.9.2"
  }
}
