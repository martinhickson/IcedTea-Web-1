# Local Linux distribution build in Docker (Corretto 11, Maven, .NET).
#
# build.sh git-clones fresh source on the host, then runs this compose file.
# Fill in build.env and run: ./.docker/workflows/build.sh

services:
  build:
    platform: linux/amd64
    build:
      context: ${ITW_WORKSPACE_ROOT:-${ITW_REPO_ROOT}}
      dockerfile: .docker/workflows/build.dockerfile
    environment:
      ITW_WORKSPACE_ROOT: ${ITW_WORKSPACE_ROOT:-${ITW_REPO_ROOT}}
      ITW_VERSION: ${ITW_VERSION:-}
      ITW_DOTNET_SELF_CONTAINED: ${ITW_DOTNET_SELF_CONTAINED:-true}
      ITW_DOTNET_RUNTIME_IDENTIFIER: ${ITW_DOTNET_RUNTIME_IDENTIFIER:-linux-x64}
      ITW_CORRETTO_URL: ${ITW_CORRETTO_URL:-}
      HOME: /home/jenkins
    volumes:
      - type: bind
        source: ${ITW_WORKSPACE_ROOT:-${ITW_REPO_ROOT}}
        target: ${ITW_WORKSPACE_ROOT:-${ITW_REPO_ROOT}}
      - type: bind
        source: ${ITW_M2_REPOSITORY:-/home/jenkins/.m2/repository}
        target: /home/jenkins/.m2/repository
