# Git source and build settings for .docker/workflows/build.sh
#
# build.sh git-clones a fresh checkout on the host (like GitHub Actions checkout),
# then bind-mounts that clone into the Linux container for the distribution build.

# Git source (use GIT_REMOTE_URL or GITHUB_REPOSITORY)
GITHUB_REPOSITORY=martinhickson/IcedTea-Web-1
GIT_REF=1.8
# GIT_REMOTE_URL=https://github.com/martinhickson/IcedTea-Web-1.git
# GIT_TOKEN=

# Fresh clone directory on the host (default: .docker/workflows/.source)
# GIT_CLONE_DIR=/tmp/IcedTea-Web-1

# Optional build settings
# ITW_VERSION=2.0.1-SNAPSHOT
# ITW_DOTNET_SELF_CONTAINED=true
# ITW_DOTNET_RUNTIME_IDENTIFIER=linux-x64
# ITW_CORRETTO_URL=https://corretto.aws/downloads/latest/amazon-corretto-11-x64-linux-jdk.tar.gz

# Maven cache on the host (default: ~/.m2/repository)
# ITW_M2_REPOSITORY=
