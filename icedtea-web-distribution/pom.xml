<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.sourceforge.icedtea-web</groupId>
    <artifactId>icedtea-web-parent</artifactId>
    <version>3.6.4</version>
  </parent>

  <artifactId>icedtea-web-distribution</artifactId>
  <packaging>pom</packaging>

  <name>IcedTea-Web Maven Distribution</name>
  <description>Maven-built IcedTea-Web distribution with .NET launcher and bundled Temurin JREs</description>

  <properties>
    <itw.distribution.root>${project.build.directory}/dist/icedtea-web-${project.version}</itw.distribution.root>
    <itw.distribution.platform>linux</itw.distribution.platform>
    <itw.dotnet.runtime.identifier>linux-x64</itw.dotnet.runtime.identifier>
    <itw.dotnet.framework>net8.0</itw.dotnet.framework>
    <itw.dotnet.selfContained>true</itw.dotnet.selfContained>
    <itw.launcher.extension></itw.launcher.extension>
    <!-- Temurin JREs (linux) — Corretto 11 retired -->
    <itw.linux.temurin11.url>https://api.adoptium.net/v3/binary/latest/11/ga/linux/x64/jre/hotspot/normal/eclipse</itw.linux.temurin11.url>
    <itw.linux.temurin11.archive>${project.build.directory}/downloads/temurin-11-linux-jre.tar.gz</itw.linux.temurin11.archive>
    <itw.linux.temurin17.url>https://api.adoptium.net/v3/binary/latest/17/ga/linux/x64/jre/hotspot/normal/eclipse</itw.linux.temurin17.url>
    <itw.linux.temurin17.archive>${project.build.directory}/downloads/temurin-17-linux-jre.tar.gz</itw.linux.temurin17.archive>
    <itw.linux.temurin21.url>https://api.adoptium.net/v3/binary/latest/21/ga/linux/x64/jre/hotspot/normal/eclipse</itw.linux.temurin21.url>
    <itw.linux.temurin21.archive>${project.build.directory}/downloads/temurin-21-linux-jre.tar.gz</itw.linux.temurin21.archive>
    <itw.linux.temurin25.url>https://api.adoptium.net/v3/binary/latest/25/ga/linux/x64/jre/hotspot/normal/eclipse</itw.linux.temurin25.url>
    <itw.linux.temurin25.archive>${project.build.directory}/downloads/temurin-25-linux-jre.tar.gz</itw.linux.temurin25.archive>
    <itw.uberjar.classifier>uber</itw.uberjar.classifier>
    <itw.native.packages.skip>true</itw.native.packages.skip>
    <itw.native.package.formats>deb rpm</itw.native.package.formats>
    <itw.launcher.icon>${project.basedir}/../win-installer/icon.ico</itw.launcher.icon>
    <itw.launcher.icon.png>${project.basedir}/../.packaging/workflows/icons/icedtea-web.png</itw.launcher.icon.png>
  </properties>

  <dependencies>
    <dependency>
      <groupId>net.sourceforge.icedtea-web</groupId>
      <artifactId>icedtea-web</artifactId>
      <version>${project.version}</version>
      <classifier>${itw.uberjar.classifier}</classifier>
      <type>jar</type>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>copy-runtime-artifacts</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>net.sourceforge.icedtea-web</groupId>
                  <artifactId>icedtea-web</artifactId>
                  <version>${project.version}</version>
                  <classifier>${itw.uberjar.classifier}</classifier>
                  <type>jar</type>
                  <destFileName>icedtea-web-uber.jar</destFileName>
                  <outputDirectory>${project.build.directory}/staging/lib</outputDirectory>
                </artifactItem>
                <artifactItem>
                  <groupId>net.bytebuddy</groupId>
                  <artifactId>byte-buddy-agent</artifactId>
                  <version>${bytebuddy.version}</version>
                  <type>jar</type>
                  <destFileName>byte-buddy-agent.jar</destFileName>
                  <outputDirectory>${project.build.directory}/staging/bin</outputDirectory>
                </artifactItem>
              </artifactItems>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>publish-dotnet-launcher-gui</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}/../dotnet-launcher</workingDirectory>
              <executable>dotnet</executable>
              <arguments>
                <argument>publish</argument>
                <argument>JavawsLauncher.csproj</argument>
                <argument>--configuration</argument>
                <argument>Release</argument>
                <argument>--framework</argument>
                <argument>${itw.dotnet.framework}</argument>
                <argument>--runtime</argument>
                <argument>${itw.dotnet.runtime.identifier}</argument>
                <argument>--self-contained</argument>
                <argument>${itw.dotnet.selfContained}</argument>
                <argument>-p:PublishSingleFile=false</argument>
                <argument>-p:PublishReadyToRun=true</argument>
                <argument>-p:DebugType=none</argument>
                <argument>--output</argument>
                <argument>${project.build.directory}/dotnet-publish</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>clean-dotnet-launcher-shared-gui</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}/../dotnet-launcher</workingDirectory>
              <executable>dotnet</executable>
              <arguments>
                <argument>clean</argument>
                <argument>JavawsLauncher.csproj</argument>
                <argument>--configuration</argument>
                <argument>Release</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>clean-dotnet-launcher-shared-console</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}/../dotnet-launcher</workingDirectory>
              <executable>dotnet</executable>
              <arguments>
                <argument>clean</argument>
                <argument>JavawscLauncher.csproj</argument>
                <argument>--configuration</argument>
                <argument>Release</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>publish-dotnet-launcher-console</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}/../dotnet-launcher</workingDirectory>
              <executable>dotnet</executable>
              <arguments>
                <argument>publish</argument>
                <argument>JavawscLauncher.csproj</argument>
                <argument>--configuration</argument>
                <argument>Release</argument>
                <argument>--framework</argument>
                <argument>${itw.dotnet.framework}</argument>
                <argument>--runtime</argument>
                <argument>${itw.dotnet.runtime.identifier}</argument>
                <argument>--self-contained</argument>
                <argument>${itw.dotnet.selfContained}</argument>
                <argument>-p:PublishSingleFile=false</argument>
                <argument>-p:PublishReadyToRun=true</argument>
                <argument>-p:DebugType=none</argument>
                <argument>--output</argument>
                <argument>${project.build.directory}/dotnet-publish-console</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>build-linux-native-packages</id>
            <phase>verify</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${itw.native.packages.skip}</skip>
              <workingDirectory>${project.basedir}/..</workingDirectory>
              <executable>${bash.executable}</executable>
              <environmentVariables>
                <ITW_VERSION>${project.version}</ITW_VERSION>
                <ITW_NATIVE_OUTPUT_DIR>${project.build.directory}/native-packages</ITW_NATIVE_OUTPUT_DIR>
                <ITW_PACKAGE_FORMATS>${itw.native.package.formats}</ITW_PACKAGE_FORMATS>
              </environmentVariables>
              <arguments>
                <argument>.packaging/workflows/linux/build-native-packages.sh</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>merge-dotnet-console-launcher</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <copy todir="${project.build.directory}/dotnet-publish" overwrite="true">
                  <fileset dir="${project.build.directory}/dotnet-publish-console">
                    <include name="javawsc*"/>
                  </fileset>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <profile>
      <id>distribution-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <itw.distribution.platform>windows</itw.distribution.platform>
        <itw.dotnet.runtime.identifier>win-x64</itw.dotnet.runtime.identifier>
        <itw.launcher.extension>.exe</itw.launcher.extension>
        <!-- Temurin JREs for multi-JDK support. Corretto 11 is retired: the download
             JVM must be a current JDK (modern TLS cipher suite support), and Temurin-11
             JRE covers the app-side Java-11 requirement. -->
        <itw.temurin11.url>https://api.adoptium.net/v3/binary/latest/11/ga/windows/x64/jre/hotspot/normal/eclipse</itw.temurin11.url>
        <itw.temurin11.archive>${project.build.directory}/downloads/temurin-11-jre.zip</itw.temurin11.archive>
        <itw.temurin17.url>https://api.adoptium.net/v3/binary/latest/17/ga/windows/x64/jre/hotspot/normal/eclipse</itw.temurin17.url>
        <itw.temurin17.archive>${project.build.directory}/downloads/temurin-17-jre.zip</itw.temurin17.archive>
        <itw.temurin21.url>https://api.adoptium.net/v3/binary/latest/21/ga/windows/x64/jre/hotspot/normal/eclipse</itw.temurin21.url>
        <itw.temurin21.archive>${project.build.directory}/downloads/temurin-21-jre.zip</itw.temurin21.archive>
        <itw.temurin25.url>https://api.adoptium.net/v3/binary/latest/25/ga/windows/x64/jre/hotspot/normal/eclipse</itw.temurin25.url>
        <itw.temurin25.archive>${project.build.directory}/downloads/temurin-25-jre.zip</itw.temurin25.archive>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>assemble-windows-dotnet-temurin-distribution</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <delete dir="${itw.distribution.root}"/>
                    <mkdir dir="${itw.distribution.root}/bin"/>
                    <mkdir dir="${itw.distribution.root}/lib"/>
                    <mkdir dir="${project.build.directory}/downloads"/>

                    <copy todir="${itw.distribution.root}/bin">
                      <fileset dir="${project.build.directory}/dotnet-publish"/>
                    </copy>
                    <copy file="${itw.distribution.root}/bin/javaws.exe" tofile="${itw.distribution.root}/bin/icedtea-web-settings.exe"/>
                    <!-- Duplicate PE (not a link): NTFS symlink needs admin/Developer Mode; hard links split on MSI repair. -->
                    <copy file="${itw.distribution.root}/bin/javaws.exe" tofile="${itw.distribution.root}/bin/itweb-settings.exe"/>
                    <copy file="${itw.distribution.root}/bin/javaws.exe" tofile="${itw.distribution.root}/bin/policyeditor.exe"/>
                    <copy file="${project.build.directory}/staging/bin/byte-buddy-agent.jar" todir="${itw.distribution.root}/bin"/>
                    <copy file="${project.build.directory}/staging/lib/icedtea-web-uber.jar" todir="${itw.distribution.root}/lib"/>

                    <mkdir dir="${itw.distribution.root}/runtime/temurin-11"/>
                    <mkdir dir="${itw.distribution.root}/runtime/temurin-17"/>
                    <mkdir dir="${itw.distribution.root}/runtime/temurin-21"/>
                    <mkdir dir="${itw.distribution.root}/runtime/temurin-25"/>
                    <mkdir dir="${project.build.directory}/downloads"/>

                    <!-- retries: Adoptium/GitHub occasionally returns 503 on GHA -->
                    <get src="${itw.temurin11.url}" dest="${itw.temurin11.archive}" skipexisting="true" retries="5"/>
                    <get src="${itw.temurin17.url}" dest="${itw.temurin17.archive}" skipexisting="true" retries="5"/>
                    <get src="${itw.temurin21.url}" dest="${itw.temurin21.archive}" skipexisting="true" retries="5"/>
                    <get src="${itw.temurin25.url}" dest="${itw.temurin25.archive}" skipexisting="true" retries="5"/>

                    <delete file="${project.build.directory}/icedtea-web-${project.version}-${itw.dotnet.runtime.identifier}.zip"/>
                    <zip destfile="${project.build.directory}/icedtea-web-${project.version}-${itw.dotnet.runtime.identifier}.zip">
                      <zipfileset dir="${project.build.directory}/dist">
                        <exclude name="**/bin/*"/>
                        <exclude name="**/runtime/temurin-*/**/bin/*"/>
                      </zipfileset>
                      <zipfileset dir="${project.build.directory}/dist" filemode="755">
                        <include name="**/bin/*"/>
                        <include name="**/runtime/temurin-*/**/bin/*"/>
                      </zipfileset>
                    </zip>
                    <unzip src="${itw.temurin11.archive}" dest="${itw.distribution.root}/runtime/temurin-11"/>
                    <unzip src="${itw.temurin17.archive}" dest="${itw.distribution.root}/runtime/temurin-17"/>
                    <unzip src="${itw.temurin21.archive}" dest="${itw.distribution.root}/runtime/temurin-21"/>
                    <unzip src="${itw.temurin25.archive}" dest="${itw.distribution.root}/runtime/temurin-25"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>distribution-linux</id>
      <activation>
        <os>
          <family>unix</family>
          <name>Linux</name>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>assemble-linux-dotnet-temurin-distribution</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <delete dir="${itw.distribution.root}"/>
                    <mkdir dir="${itw.distribution.root}/bin"/>
                    <mkdir dir="${itw.distribution.root}/lib"/>
                    <mkdir dir="${itw.distribution.root}/share/pixmaps"/>
                    <mkdir dir="${project.build.directory}/downloads"/>

                    <copy todir="${itw.distribution.root}/bin">
                      <fileset dir="${project.build.directory}/dotnet-publish"/>
                    </copy>
                    <copy file="${itw.distribution.root}/bin/javaws" tofile="${itw.distribution.root}/bin/icedtea-web-settings"/>
                    <copy file="${itw.distribution.root}/bin/javaws" tofile="${itw.distribution.root}/bin/policyeditor"/>
                    <chmod file="${itw.distribution.root}/bin/javaws" perm="ugo+rx"/>
                    <chmod file="${itw.distribution.root}/bin/javawsc" perm="ugo+rx"/>
                    <chmod file="${itw.distribution.root}/bin/icedtea-web-settings" perm="ugo+rx"/>
                    <chmod file="${itw.distribution.root}/bin/policyeditor" perm="ugo+rx"/>
                    <!-- 2.9.x compatibility name; relative symlink so zip/deb/rpm stay one binary. -->
                    <exec executable="ln">
                      <arg value="-sfn"/>
                      <arg value="icedtea-web-settings"/>
                      <arg value="${itw.distribution.root}/bin/itweb-settings"/>
                    </exec>
                    <copy file="${itw.launcher.icon.png}" tofile="${itw.distribution.root}/share/pixmaps/javaws.png"/>
                    <copy file="${itw.launcher.icon.png}" tofile="${itw.distribution.root}/share/pixmaps/icedtea-web-settings.png"/>
                    <copy file="${itw.launcher.icon.png}" tofile="${itw.distribution.root}/share/pixmaps/policyeditor.png"/>
                    <copy file="${project.build.directory}/staging/bin/byte-buddy-agent.jar" todir="${itw.distribution.root}/bin"/>
                    <copy file="${project.build.directory}/staging/lib/icedtea-web-uber.jar" todir="${itw.distribution.root}/lib"/>

                    <mkdir dir="${itw.distribution.root}/runtime/temurin-11"/>
                    <mkdir dir="${itw.distribution.root}/runtime/temurin-17"/>
                    <mkdir dir="${itw.distribution.root}/runtime/temurin-21"/>
                    <mkdir dir="${itw.distribution.root}/runtime/temurin-25"/>

                    <get src="${itw.linux.temurin11.url}" dest="${itw.linux.temurin11.archive}" skipexisting="true"/>
                    <get src="${itw.linux.temurin17.url}" dest="${itw.linux.temurin17.archive}" skipexisting="true"/>
                    <get src="${itw.linux.temurin21.url}" dest="${itw.linux.temurin21.archive}" skipexisting="true"/>
                    <get src="${itw.linux.temurin25.url}" dest="${itw.linux.temurin25.archive}" skipexisting="true"/>
                    <untar src="${itw.linux.temurin11.archive}" dest="${itw.distribution.root}/runtime/temurin-11" compression="gzip"/>
                    <untar src="${itw.linux.temurin17.archive}" dest="${itw.distribution.root}/runtime/temurin-17" compression="gzip"/>
                    <untar src="${itw.linux.temurin21.archive}" dest="${itw.distribution.root}/runtime/temurin-21" compression="gzip"/>
                    <untar src="${itw.linux.temurin25.archive}" dest="${itw.distribution.root}/runtime/temurin-25" compression="gzip"/>

                    <delete file="${project.build.directory}/icedtea-web-${project.version}-${itw.dotnet.runtime.identifier}.zip"/>
                    <zip destfile="${project.build.directory}/icedtea-web-${project.version}-${itw.dotnet.runtime.identifier}.zip">
                      <zipfileset dir="${project.build.directory}/dist">
                        <exclude name="**/bin/*"/>
                        <exclude name="**/runtime/temurin-*/**/bin/*"/>
                        <exclude name="**/runtime/temurin-*/**/lib/jspawnhelper"/>
                      </zipfileset>
                      <zipfileset dir="${project.build.directory}/dist" filemode="755" followsymlinks="false">
                        <include name="**/bin/*"/>
                        <include name="**/runtime/temurin-*/**/bin/*"/>
                        <include name="**/runtime/temurin-*/**/lib/jspawnhelper"/>
                      </zipfileset>
                    </zip>
                    <chmod perm="ugo+rx">
                      <fileset dir="${itw.distribution.root}/runtime">
                        <include name="temurin-*/**/bin/*"/>
                        <include name="temurin-*/**/lib/jspawnhelper"/>
                      </fileset>
                    </chmod>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>distribution-macos</id>
      <activation>
        <os>
          <family>mac</family>
        </os>
      </activation>
      <properties>
        <itw.distribution.platform>macos</itw.distribution.platform>
        <itw.dotnet.runtime.identifier>osx-x64</itw.dotnet.runtime.identifier>
        <!-- Temurin JREs (macos x64) — Corretto 11 retired. macOS JRE
             tarballs extract to a jdk-<ver> bundle with Contents/Home layout. -->
        <itw.mac.temurin11.url>https://api.adoptium.net/v3/binary/latest/11/ga/mac/x64/jre/hotspot/normal/eclipse</itw.mac.temurin11.url>
        <itw.mac.temurin11.archive>${project.build.directory}/downloads/temurin-11-mac-jre.tar.gz</itw.mac.temurin11.archive>
        <itw.mac.temurin17.url>https://api.adoptium.net/v3/binary/latest/17/ga/mac/x64/jre/hotspot/normal/eclipse</itw.mac.temurin17.url>
        <itw.mac.temurin17.archive>${project.build.directory}/downloads/temurin-17-mac-jre.tar.gz</itw.mac.temurin17.archive>
        <itw.mac.temurin21.url>https://api.adoptium.net/v3/binary/latest/21/ga/mac/x64/jre/hotspot/normal/eclipse</itw.mac.temurin21.url>
        <itw.mac.temurin21.archive>${project.build.directory}/downloads/temurin-21-mac-jre.tar.gz</itw.mac.temurin21.archive>
        <itw.mac.temurin25.url>https://api.adoptium.net/v3/binary/latest/25/ga/mac/x64/jre/hotspot/normal/eclipse</itw.mac.temurin25.url>
        <itw.mac.temurin25.archive>${project.build.directory}/downloads/temurin-25-mac-jre.tar.gz</itw.mac.temurin25.archive>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>assemble-macos-dotnet-temurin-distribution</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <delete dir="${itw.distribution.root}"/>
                    <mkdir dir="${itw.distribution.root}/bin"/>
                    <mkdir dir="${itw.distribution.root}/lib"/>
                    <mkdir dir="${itw.distribution.root}/share/icons"/>
                    <mkdir dir="${project.build.directory}/downloads"/>

                    <copy todir="${itw.distribution.root}/bin">
                      <fileset dir="${project.build.directory}/dotnet-publish"/>
                    </copy>
                    <copy file="${itw.distribution.root}/bin/javaws" tofile="${itw.distribution.root}/bin/icedtea-web-settings"/>
                    <copy file="${itw.distribution.root}/bin/javaws" tofile="${itw.distribution.root}/bin/policyeditor"/>
                    <chmod file="${itw.distribution.root}/bin/javaws" perm="ugo+rx"/>
                    <chmod file="${itw.distribution.root}/bin/javawsc" perm="ugo+rx"/>
                    <chmod file="${itw.distribution.root}/bin/icedtea-web-settings" perm="ugo+rx"/>
                    <chmod file="${itw.distribution.root}/bin/policyeditor" perm="ugo+rx"/>
                    <!-- 2.9.x compatibility name; relative symlink so the zip stays one binary. -->
                    <exec executable="ln">
                      <arg value="-sfn"/>
                      <arg value="icedtea-web-settings"/>
                      <arg value="${itw.distribution.root}/bin/itweb-settings"/>
                    </exec>
                    <copy file="${itw.launcher.icon.png}" tofile="${itw.distribution.root}/share/icons/icedtea-web.png"/>
                    <copy file="${project.build.directory}/staging/bin/byte-buddy-agent.jar" todir="${itw.distribution.root}/bin"/>
                    <copy file="${project.build.directory}/staging/lib/icedtea-web-uber.jar" todir="${itw.distribution.root}/lib"/>

                    <mkdir dir="${itw.distribution.root}/runtime/temurin-11"/>
                    <mkdir dir="${itw.distribution.root}/runtime/temurin-17"/>
                    <mkdir dir="${itw.distribution.root}/runtime/temurin-21"/>
                    <mkdir dir="${itw.distribution.root}/runtime/temurin-25"/>

                    <get src="${itw.mac.temurin11.url}" dest="${itw.mac.temurin11.archive}" skipexisting="true"/>
                    <get src="${itw.mac.temurin17.url}" dest="${itw.mac.temurin17.archive}" skipexisting="true"/>
                    <get src="${itw.mac.temurin21.url}" dest="${itw.mac.temurin21.archive}" skipexisting="true"/>
                    <get src="${itw.mac.temurin25.url}" dest="${itw.mac.temurin25.archive}" skipexisting="true"/>
