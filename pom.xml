<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.sourceforge.icedtea-web</groupId>
  <artifactId>icedtea-web-parent</artifactId>
  <version>3.5.2</version>
  <packaging>pom</packaging>

  <name>IcedTea-Web Parent</name>
  <description>Parent POM for IcedTea-Web Maven build</description>

  <modules>
    <module>icedtea-web</module>
    <module>icedtea-web-integration</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.compiler.plugin.version>3.11.0</maven.compiler.plugin.version>
    <maven.enforcer.plugin.version>3.3.0</maven.enforcer.plugin.version>
    <maven.compiler.source>11</maven.compiler.source>
    <maven.compiler.target>11</maven.compiler.target>
    <jdk8.home>/usr/lib/jvm/java-1.8.0-amazon-corretto</jdk8.home>
    <!-- Fork javac from a JDK 11 home so bytecode and bootclasspath match JDK 11 runtimes. -->
    <jdk11.home>/usr/lib/jvm/java-11-amazon-corretto</jdk11.home>
    <maven.compiler.fork>true</maven.compiler.fork>
    <maven.compiler.executable>${jdk11.home}/bin/javac</maven.compiler.executable>
    <junit.version>5.10.2</junit.version>
    <jacoco.version>0.8.12</jacoco.version>
    <sqlite.jdbc.version>3.46.1.3</sqlite.jdbc.version>
    <!-- Java 17: 1.10.19+, Java 21: 1.14.3+, Java 25: 1.17.0+ (see byte-buddy README compatibility table) -->
    <bytebuddy.version>1.18.8</bytebuddy.version>
    <bash.executable>bash</bash.executable>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>net.bytebuddy</groupId>
        <artifactId>byte-buddy</artifactId>
        <version>${bytebuddy.version}</version>
      </dependency>
      <dependency>
        <groupId>net.bytebuddy</groupId>
        <artifactId>byte-buddy-agent</artifactId>
        <version>${bytebuddy.version}</version>
      </dependency>
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite.jdbc.version}</version>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.icedtea-web</groupId>
        <artifactId>icedtea-web</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>net.sourceforge.icedtea-web</groupId>
        <artifactId>icedtea-web</artifactId>
        <version>${project.version}</version>
        <classifier>uber</classifier>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
          <configuration>
            <source>${maven.compiler.source}</source>
            <target>${maven.compiler.target}</target>
            <encoding>UTF-8</encoding>
            <fork>${maven.compiler.fork}</fork>
            <executable>${maven.compiler.executable}</executable>
            <!-- Required when source is 11+: JDK-internal APIs used by ITW. -->
            <excludes>
              <!-- Conflicts with java.desktop when source >= 11; plugin code owns sun.applet. -->
              <exclude>sun/applet/**</exclude>
            </excludes>
            <compilerArgs>
              <arg>--add-exports</arg>
              <arg>java.base/sun.net.www.protocol.jar=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.base/sun.security.action=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.base/sun.security.provider=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.base/sun.security.util=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.base/sun.security.validator=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.base/sun.security.x509=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.base/jdk.internal.util.jar=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.base/sun.net.www.protocol.http=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.desktop/sun.applet=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.desktop/sun.awt=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.desktop/sun.awt.windows=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.desktop/sun.awt.image=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.desktop/sun.awt.X11=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.desktop/sun.swing.table=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.desktop/sun.swing=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.desktop/sun.swing.plaf=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.desktop/com.sun.java.swing.plaf.windows=ALL-UNNAMED</arg>
              <arg>--add-exports</arg>
              <arg>java.naming/com.sun.jndi.toolkit.url=ALL-UNNAMED</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven.enforcer.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.jacoco</groupId>
          <artifactId>jacoco-maven-plugin</artifactId>
          <version>${jacoco.version}</version>
          <configuration>
            <excludes>
              <exclude>net/sourceforge/jnlp/mock/**</exclude>
            </excludes>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!-- Windows local builds: Amazon Corretto 11 under Program Files -->
    <profile>
      <id>jdk11-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
        <file>
          <exists>C:/Program Files/Amazon Corretto/jdk11.0.21_9/bin/javac.exe</exists>
        </file>
      </activation>
      <properties>
        <jdk11.home>C:/Program Files/Amazon Corretto/jdk11.0.21_9</jdk11.home>
      </properties>
    </profile>
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>report-aggregate</id>
                <phase>verify</phase>
                <goals>
                  <goal>report-aggregate</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>maven-distribution</id>
      <modules>
        <module>icedtea-web-distribution</module>
      </modules>
    </profile>
  </profiles>

</project>
