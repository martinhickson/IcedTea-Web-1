# Jenkins Windows release: full build in Docker (Maven, MSI, Key Vault signing).
# Requires a Windows Docker host (Windows containers mode).
#
# sign.jenkinsfile checks out source into WORKSPACE, then invokes this compose file.

services:
  sign:
    platform: windows/amd64
    build:
      context: .
      dockerfile: sign.dockerfile
    environment:
      ITW_WORKSPACE_ROOT: ${WORKSPACE}
      ITW_VERSION: ${ITW_VERSION:-}
      ITW_DOTNET_SELF_CONTAINED: ${ITW_DOTNET_SELF_CONTAINED:-true}
      ITW_CORRETTO_URL: ${ITW_CORRETTO_URL:-https://corretto.aws/downloads/latest/amazon-corretto-11-x64-windows-jdk.zip}
      KEYVAULT_URL: ${KEYVAULT_URL}
      AZURE_CLIENT_ID: ${AZURE_CLIENT_ID}
      AZURE_TENANT_ID: ${AZURE_TENANT_ID}
      AZURE_CLIENT_SECRET: ${AZURE_CLIENT_SECRET}
      JNLP_JCA_SIGN_ALIAS: ${JNLP_JCA_SIGN_ALIAS}
      JNLP_JCA_TSA_URL: ${JNLP_JCA_TSA_URL}
      JNLP_JCA_SIGN_CERTCHAIN: ${JNLP_JCA_SIGN_CERTCHAIN:-}
      JNLP_JCA_SIGN_CERTCHAIN_FILE: ${JNLP_JCA_SIGN_CERTCHAIN_FILE:-C:\signing\certchain.pem}
      GITHUB_REPOSITORY: ${GITHUB_REPOSITORY:-martinhickson/IcedTea-Web-1}
    volumes:
      - type: bind
        source: ${WORKSPACE}
        target: ${WORKSPACE}
      - type: bind
        source: ${JNLP_JCA_SIGN_CERTCHAIN_HOST_FILE}
        target: C:\signing\certchain.pem
        read_only: true
