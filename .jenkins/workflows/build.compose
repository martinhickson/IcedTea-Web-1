# Jenkins distribution build in Docker (Corretto 11, Maven, .NET).
# build.jenkinsfile checks out source into WORKSPACE, then invokes this compose file.

services:
  build:
    platform: linux/amd64
    build:
      context: ${ITW_WORKSPACE_ROOT:-${WORKSPACE}}
      dockerfile: .jenkins/workflows/build.dockerfile
      args:
        JENKINS_UID: ${JENKINS_UID:-1000}
        JENKINS_GID: ${JENKINS_GID:-1000}
    environment:
      ITW_WORKSPACE_ROOT: ${ITW_WORKSPACE_ROOT:-${WORKSPACE}}
      ITW_VERSION: ${ITW_VERSION:-}
      ITW_DOTNET_SELF_CONTAINED: ${ITW_DOTNET_SELF_CONTAINED:-true}
      ITW_DOTNET_RUNTIME_IDENTIFIER: ${ITW_DOTNET_RUNTIME_IDENTIFIER:-linux-x64}
      ITW_CORRETTO_URL: ${ITW_CORRETTO_URL:-}
      ITW_MAVEN_SETTINGS: ${ITW_WORKSPACE_ROOT:-${WORKSPACE}}/.jenkins/workflows/maven-settings.xml
      HOME: /home/jenkins
    volumes:
      - type: bind
        source: ${ITW_WORKSPACE_ROOT:-${WORKSPACE}}
        target: ${ITW_WORKSPACE_ROOT:-${WORKSPACE}}
      - type: bind
        source: ${ITW_M2_REPOSITORY:-/home/jenkins/.m2/repository}
        target: /home/jenkins/.m2/repository
