<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <!-- pack200 is io.github.martinhickson:pack200 on Maven Central. -->
  <!-- Route central through the GCS mirror — Sonatype rate-limits shared GitHub Actions egress (HTTP 429). -->
  <!-- Host PowerShell workflow uses an identical copy at .powershell/workflows/maven-settings.xml -->
  <mirrors>
    <mirror>
      <id>google-maven-central</id>
      <name>GCS Maven Central mirror</name>
      <url>https://maven-central.storage-download.googleapis.com/maven2/</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>
</settings>
