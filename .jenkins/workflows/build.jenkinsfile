pipeline {
    agent {
        label 'linux'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {
        string(
            name: 'GIT_REF',
            defaultValue: '1.8',
            description: 'Git branch or tag to checkout into WORKSPACE'
        )
        string(
            name: 'ITW_VERSION',
            defaultValue: '',
            description: 'Release version (optional; defaults to pom.xml project version when empty)'
        )
        choice(
            name: 'ITW_DOTNET_SELF_CONTAINED',
            choices: ['true', 'false'],
            description: 'Bundle the .NET runtime in the launcher distribution'
        )
        choice(
            name: 'ITW_DOTNET_RUNTIME_IDENTIFIER',
            choices: ['linux-x64', 'win-x64', 'osx-x64', 'osx-arm64'],
            description: 'Target .NET runtime identifier for the distribution build'
        )
        booleanParam(
            name: 'DRY_RUN',
            defaultValue: false,
            description: 'Resolve version from pom.xml and skip the distribution build'
        )
    }

    environment {
        DOCKER_BIN = 'docker'
        ITW_M2_REPOSITORY = '/home/jenkins/.m2/repository'
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: "${params.GIT_REF}"]],
                    doGenerateSubmoduleConfigurations: false,
                    extensions: [[$class: 'CloneOption', depth: 1, shallow: true, honorRefspec: true]],
                    userRemoteConfigs: scm.userRemoteConfigs
                ])
            }
        }

        stage('Build distribution') {
            steps {
                script {
                    if (params.ITW_VERSION != null && params.ITW_VERSION.trim() != '') {
                        env.ITW_VERSION = params.ITW_VERSION.trim()
                    }
                    env.ITW_DOTNET_SELF_CONTAINED = params.ITW_DOTNET_SELF_CONTAINED
                    env.ITW_DOTNET_RUNTIME_IDENTIFIER = params.ITW_DOTNET_RUNTIME_IDENTIFIER
                    env.ITW_DRY_RUN = params.DRY_RUN ? 'true' : 'false'
                }
                sh '''#!/bin/bash
                    set -euo pipefail
                    source "$WORKSPACE/.docker/workflows/build.sh"
                    run_jenkins_controller "$WORKSPACE/.jenkins/workflows"
                '''
            }
        }

        stage('Archive distribution artifacts') {
            when {
                expression { return !params.DRY_RUN }
            }
            steps {
                archiveArtifacts artifacts: '''
                    icedtea-web-distribution/target/*.zip
                ''', fingerprint: true, onlyIfSuccessful: true
            }
        }
    }
}
