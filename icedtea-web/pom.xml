<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>net.sourceforge.icedtea-web</groupId>
    <artifactId>icedtea-web-parent</artifactId>
    <version>3.7.2</version>
  </parent>

  <artifactId>icedtea-web</artifactId>
  <packaging>jar</packaging>

  <name>IcedTea-Web</name>
  <description>IcedTea-Web main project (non-standard source layout)</description>

  <properties>
    <maven.build.helper.plugin.version>3.3.0</maven.build.helper.plugin.version>
    <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
    <exec.maven.plugin.version>3.1.1</exec.maven.plugin.version>
    <uberjar.mainClass>net.sourceforge.jnlp.runtime.JavawsUberLauncher</uberjar.mainClass>
    <uberjar.classifier>uber</uberjar.classifier>
    <itw.generated.resources.dir>${project.build.directory}/generated-resources/net/sourceforge/jnlp/resources</itw.generated.resources.dir>
    <itw.html.gen.changesets>140</itw.html.gen.changesets>
    <pack200.version>11.0.4</pack200.version>
    <pack200.verify.dir>${project.build.directory}/pack200-verify</pack200.verify.dir>
    <uberjar.file>${project.build.directory}/${project.build.finalName}-${uberjar.classifier}.jar</uberjar.file>
    <jacocoArgLine></jacocoArgLine>
    <itw.jpms.argLine></itw.jpms.argLine>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.ccil.cowan.tagsoup</groupId>
      <artifactId>tagsoup</artifactId>
      <version>1.2.1</version>
    </dependency>
    <dependency>
      <groupId>com.github.vatbub</groupId>
      <artifactId>mslinks</artifactId>
      <version>1.0.5.1</version>
    </dependency>
    <dependency>
      <groupId>org.mozilla</groupId>
      <artifactId>rhino</artifactId>
      <version>1.7R3</version>
    </dependency>
    <dependency>
      <groupId>io.github.martinhickson</groupId>
      <artifactId>pack200</artifactId>
      <version>${pack200.version}</version>
    </dependency>
    <!-- ByteBuddy for runtime JarFile.close() protection (see JarFileCloseProtection.java) -->
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.httpcomponents.client5</groupId>
      <artifactId>httpclient5</artifactId>
      <version>5.6.4</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>1.7.36</version>
    </dependency>
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.vintage</groupId>
      <artifactId>junit-vintage-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>4.11.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>4.11.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>2.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- pack200 11.0.4+ is on Maven Central (io.github.martinhickson:pack200). -->

  <build>
    <testSourceDirectory>${project.basedir}/../tests-disabled</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-java</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[11,)</version>
                  <message>Maven host JVM must be JDK 11 or later to build. Output bytecode is Java 11 only (source/target 11) so runtime stays JDK 11-compatible — not a newer class-file level.</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.6.0,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Fail fast when the resolved pack200 jar cannot unpack .pack.gz: some
           older GitHub Packages jars omitted io/pack200/pack/intrinsic.properties.
           Maven Central 11.0.4+ includes it. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>verify-pack200-intrinsic</id>
            <phase>validate</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <property name="pack200.jar" value="${settings.localRepository}/io/github/martinhickson/pack200/${pack200.version}/pack200-${pack200.version}.jar"/>
                <condition property="pack200.intrinsic.ok">
                  <and>
                    <available file="${pack200.jar}"/>
                    <resourcecount count="1">
                      <zipfileset src="${pack200.jar}">
                        <patternset>
                          <include name="io/pack200/pack/intrinsic.properties"/>
                        </patternset>
                      </zipfileset>
                    </resourcecount>
                  </and>
                </condition>
                <fail message="pack200 ${pack200.version} at ${pack200.jar} is missing io/pack200/pack/intrinsic.properties — pack.gz downloads would fail at runtime. Resolve io.github.martinhickson:pack200 from Maven Central (11.0.4+).">
                  <condition>
                    <not>
                      <isset property="pack200.intrinsic.ok"/>
                    </not>
                  </condition>
                </fail>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>${maven.build.helper.plugin.version}</version>
        <executions>
          <execution>
            <id>add-netx-source</id>
            <goals>
              <goal>add-source</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <sources>
                <source>${project.basedir}/../netx</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-netx-resources</id>
            <goals>
              <goal>add-resource</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <resources>
                <resource>
                  <directory>${project.basedir}/../netx</directory>
                  <excludes>
                    <exclude>**/*.java</exclude>
                    <!-- Split package with java.desktop when compiling as source 11 -->
                    <exclude>sun/applet/**</exclude>
                  </excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>add-tests-source</id>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <phase>generate-test-sources</phase>
            <configuration>
              <sources>
                <source>${project.basedir}/../tests/netx/unit</source>
                <source>${project.basedir}/../tests/netx/it</source>
                <source>${project.basedir}/../tests/test-extensions</source>
              </sources>
            </configuration>
          </execution>
          <execution>
            <id>add-test-resources</id>
            <goals>
              <goal>add-test-resource</goal>
            </goals>
            <phase>generate-test-resources</phase>
            <configuration>
              <resources>
                <resource>
                  <directory>${project.basedir}/../tests/netx/unit</directory>
                  <excludes>
                    <exclude>**/*.java</exclude>
                  </excludes>
                </resource>
                <resource>
                  <directory>${project.basedir}/../tests/test-extensions</directory>
                  <excludes>
                    <exclude>**/*.java</exclude>
                  </excludes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
            <include>**/Test*.java</include>
          </includes>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
          <argLine>@{jacocoArgLine} @{itw.jpms.argLine}</argLine>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
          <argLine>@{jacocoArgLine} @{itw.jpms.argLine}</argLine>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven.shade.plugin.version}</version>
        <executions>
          <execution>
            <id>shade-uber-jar</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>${uberjar.classifier}</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <!-- Keep org.slf4j off the JNLP parent loader. HttpClient 5 and
                     the ITW binder stay wired after rewrite; apps that ship
                     SLF4J/Logback bind their own factory. -->
                <relocation>
                  <pattern>org.slf4j</pattern>
                  <shadedPattern>net.sourceforge.jnlp.shaded.slf4j</shadedPattern>
                </relocation>
              </relocations>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>${uberjar.mainClass}</mainClass>
                  <manifestEntries>
                    <Implementation-Title>IcedTea-Web</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer"/>
              </transformers>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>copy-pack200-for-intrinsic-assert</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.github.martinhickson</groupId>
                  <artifactId>pack200</artifactId>
                  <version>${pack200.version}</version>
                  <outputDirectory>${pack200.verify.dir}</outputDirectory>
                </artifactItem>
              </artifactItems>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
            </configuration>
          </execution>
          <execution>
            <id>copy-runtime-deps-for-docgen</id>
            <phase>process-classes</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/dependency-jars</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
          <execution>
            <id>copy-bytebuddy-agent</id>
            <phase>package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>net.bytebuddy</groupId>
                  <artifactId>byte-buddy-agent</artifactId>
                  <version>${bytebuddy.version}</version>
                  <destFileName>byte-buddy-agent.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/bin</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec.maven.plugin.version}</version>
        <executions>
          <execution>
            <id>generate-about-html</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}</workingDirectory>
              <executable>${bash.executable}</executable>
              <arguments>
                <argument>../scripts/maven-generate-about-html.sh</argument>
                <argument>${itw.html.gen.changesets}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-about-intro-pages</id>
            <phase>process-classes</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}</workingDirectory>
              <executable>${bash.executable}</executable>
              <arguments>
                <argument>../scripts/maven-generate-about-intro-pages.sh</argument>
                <argument>${project.version}</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-javaws-launcher</id>
            <phase>package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <workingDirectory>${project.basedir}</workingDirectory>
              <executable>${bash.executable}</executable>
              <arguments>
                <argument>../scripts/maven-generate-javaws-launcher.sh</argument>
                <argument>${project.build.finalName}</argument>
                <argument>${uberjar.classifier}</argument>
                <argument>${uberjar.mainClass}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>copy-generated-about-docs</id>
            <phase>process-classes</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/net/sourceforge/jnlp/resources</outputDirectory>
              <resources>
                <resource>
                  <directory>${itw.generated.resources.dir}</directory>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <profile>
      <id>pack200-intrinsic-assert-windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec.maven.plugin.version}</version>
            <executions>
              <execution>
                <id>assert-pack200-dependency-intrinsic</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>powershell</executable>
                  <arguments>
                    <argument>-NoProfile</argument>
                    <argument>-ExecutionPolicy</argument>
                    <argument>Bypass</argument>
                    <argument>-File</argument>
                    <argument>${project.basedir}/../scripts/assert-pack200-intrinsic-in-jar.ps1</argument>
                    <argument>${pack200.verify.dir}/pack200-${pack200.version}.jar</argument>
                    <argument>pack200 dependency (pre-shade)</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>assert-uber-jar-intrinsic</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>powershell</executable>
                  <arguments>
                    <argument>-NoProfile</argument>
                    <argument>-ExecutionPolicy</argument>
                    <argument>Bypass</argument>
                    <argument>-File</argument>
                    <argument>${project.basedir}/../scripts/assert-pack200-intrinsic-in-jar.ps1</argument>
                    <argument>${uberjar.file}</argument>
                    <argument>shaded uber jar (post-shade)</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>assert-uber-jar-sqlite-jdbc</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>powershell</executable>
                  <arguments>
                    <argument>-NoProfile</argument>
                    <argument>-ExecutionPolicy</argument>
                    <argument>Bypass</argument>
                    <argument>-File</argument>
                    <argument>${project.basedir}/../scripts/assert-entry-in-jar.ps1</argument>
                    <argument>${uberjar.file}</argument>
                    <argument>org/sqlite/JDBC.class</argument>
                    <argument>shaded uber jar sqlite-jdbc</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>assert-uber-jar-slf4j-relocated</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>powershell</executable>
                  <arguments>
                    <argument>-NoProfile</argument>
                    <argument>-ExecutionPolicy</argument>
                    <argument>Bypass</argument>
                    <argument>-File</argument>
                    <argument>${project.basedir}/../scripts/assert-no-entry-prefix-in-jar.ps1</argument>
                    <argument>${uberjar.file}</argument>
                    <argument>org/slf4j/</argument>
                    <argument>shaded uber jar hides org.slf4j</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>assert-uber-jar-slf4j-shaded-factory</id>
                <phase>verify</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>powershell</executable>
                  <arguments>
                    <argument>-NoProfile</argument>
                    <argument>-ExecutionPolicy</argument>
                    <argument>Bypass</argument>
                    <argument>-File</argument>
                    <argument>${project.basedir}/../scripts/assert-entry-in-jar.ps1</argument>
                    <argument>${uberjar.file}</argument>
                    <argument>net/sourceforge/jnlp/shaded/slf4j/LoggerFactory.class</argument>
                    <argument>shaded uber jar slf4j-api</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

