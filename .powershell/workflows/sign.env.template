# Template for .powershell/workflows/sign.ps1
#
# Create your local config (gitignored):
#   copy sign.env.template sign.env
#
# sign.ps1 uses sign.env when present; if missing, it copies this template to sign.env
# and asks you to customize it before continuing.

# Git source (use GIT_REMOTE_URL or GITHUB_REPOSITORY)
GITHUB_REPOSITORY=martinhickson/IcedTea-Web-1
GIT_REF=maint/1.8.8.12-jpms-vm-args
# GIT_REF is the application source tag/branch to build when not using -UseLocalSource.
# Workflow scripts (.github/workflows/windows_build.sh, .github/workflows/sign.ps1) are
# taken from this driver checkout, not from the cloned GIT_REF.
# GIT_REMOTE_URL=https://github.com/martinhickson/IcedTea-Web-1.git
# GIT_TOKEN=

# Fresh clone directory on the host (default: .powershell/workflows/.source)
# GIT_CLONE_DIR=C:\build\IcedTea-Web-1

# Azure Key Vault signing (Microsoft Sign CLI: installed by install-toolchain.ps1)
KEYVAULT_URL=https://your-vault.vault.azure.net/
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
# JNLP_JCA_SIGN_ALIAS = exact certificate object name in Key Vault (Certificates blade).
JNLP_JCA_SIGN_ALIAS=
JNLP_JCA_TSA_URL=http://timestamp.digicert.com
# Sign CLI requires an absolute URL with http:// or https:// (not bare timestamp.digicert.com).

# Optional build settings (classic 1.8 line compiles with JDK 8)
ITW_JDK_VERSION=8
# JAVA_HOME=C:\Users\you\bellsoft-jdk\jdk8u462
# ITW_VERSION=1.8.8.21-3

# Signing on/off (Authenticode + Key Vault). Off = full Cygwin build + MSI, no signing.
# ITW_SIGNING=off
# ITW_SIGNING=on
#
# Legacy alias (same as ITW_SIGNING=off):
# ITW_DRY_RUN=true

# Optional corporate proxy for Chocolatey/downloads on the host
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.local

# install-toolchain.ps1 installs Cygwin at C:\cygwin64 (same packages as the GitHub Actions
# Windows job), plus JDK 8 / rust / WiX 3 / .NET 8 / Sign CLI.
