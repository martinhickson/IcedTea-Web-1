# Template for .powershell/workflows/sign.ps1
#
# Create your local config (gitignored):
#   copy sign.env.template sign.env
#
# sign.ps1 uses sign.env when present; if missing, it copies this template to sign.env
# and asks you to customize it before continuing.

# Git source (use GIT_REMOTE_URL or GITHUB_REPOSITORY)
GITHUB_REPOSITORY=martinhickson/IcedTea-Web-1
GIT_REF=icedtea-web-2.6.2
# GIT_REMOTE_URL=https://github.com/martinhickson/IcedTea-Web-1.git
# GIT_TOKEN=

# Fresh clone directory on the host (default: .powershell/workflows/.source)
# GIT_CLONE_DIR=C:\build\IcedTea-Web-1

JNLP_JCA_SIGN_CERTCHAIN_HOST_FILE=C:\path\to\signing-chain.pem
# PEM file with Sectigo (or other) intermediate/root certs — NOT the Key Vault cert itself.

KEYVAULT_URL=https://your-vault.vault.azure.net/
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_SECRET=
# JNLP_JCA_SIGN_ALIAS = exact certificate object name in Key Vault (Certificates blade).
JNLP_JCA_SIGN_ALIAS=
JNLP_JCA_TSA_URL=http://timestamp.digicert.com
# If signing fails with 0x80070002, AzureSignTool often means Key Vault auth/RBAC failed
# (misleading "file not found"). Service principal needs certificate read + key sign on the vault.

# Optional: PEM inline instead of JNLP_JCA_SIGN_CERTCHAIN_HOST_FILE
# JNLP_JCA_SIGN_CERTCHAIN=

# Optional build settings
ITW_JDK_VERSION=11
# ITW_JDK11_HOME=C:\Program Files\Amazon Corretto\jdk11.0.25_9
# ITW_VERSION=2.0.1-SNAPSHOT
# ITW_DOTNET_SELF_CONTAINED=true
# ITW_CORRETTO_URL=https://corretto.aws/downloads/latest/amazon-corretto-11-x64-windows-jdk.zip

# Dry run: full Maven/MSI build; signing step runs AzureSignTool --version only
# ITW_DRY_RUN=true

# Optional corporate proxy for Chocolatey/downloads on the host
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.local
